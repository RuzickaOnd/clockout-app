<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12 and higher (API >= 31).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   Both cloud backup and device-to-device transfer carry the ritual log database and the
   settings DataStore, so reinstalling the app restores the user's history.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="clockout.db" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="clockout.db" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
